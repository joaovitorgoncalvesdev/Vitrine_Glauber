{
  "name": "vitrine-glauber-interface",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts docs *.md *.js *.json index.html gestao",
    "format:check": "prettier --check src tests scripts docs *.md *.js *.json index.html gestao",
    "dev:gestao": "vite --config gestao/vite.config.js",
    "build:gestao": "vite build --config gestao/vite.config.js",
    "test:gestao:unit": "node --test gestao/tests/*.test.js",
    "test:gestao:e2e": "playwright test --config playwright.gestao.config.js"
  },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "pinia": "^3.0.3",
    "quasar": "^2.18.5",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@quasar/vite-plugin": "^1.10.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.105.1",
    "vite": "^7.3.7"
  }
}
